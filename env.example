# LLM 配置
# 请填写您的 LLM 服务地址（OpenAI 兼容协议）
# 示例：http://127.0.0.1:1234/v1（本地 LM Studio）
# 示例：https://api.openai.com/v1（OpenAI 官方）
LLM_BASE_URL=http://127.0.0.1:1234/v1

# 模型名称
# 示例：qwen3.5-4b、gpt-3.5-turbo、gpt-4 等
LLM_MODEL=qwen3.5-4b

# API 访问令牌
# 本地模型可填写任意值，如：local、dummy
# 在线 API 需填写真实的 API Key
LLM_API_KEY=your_api_key_here

# 超时设置（秒）
# 默认 3600 秒（1 小时），适用于本地 LLM 响应速度
LLM_TIMEOUT=3600

# AnythingLLM 配置（可选）
# API 访问令牌
ANYTHINGLLM_API_KEY=your_anythingllm_api_key_here

# 工作区 slug
ANYTHINGLLM_WORKSPACE_SLUG=default
