# OpenAI兼容协议的LLM配置模板
# 请复制此文件为.env并填写正确的参数

# LLM API的基础URL
# 例如：https://api.openai.com/v1 或其他兼容的API地址
LLM_BASE_URL=https://api.example.com/v1

# 使用的模型名称
# 例如：gpt-3.5-turbo、gpt-4 或其他模型名称
LLM_MODEL=gpt-3.5-turbo

# API访问令牌
# 请填写您的API密钥
LLM_API_KEY=your_api_key_here

# 可选：API请求超时时间（秒）
LLM_TIMEOUT=30

# 可选：最大重试次数
LLM_MAX_RETRIES=3